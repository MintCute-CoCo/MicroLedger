{
  "name": "microledger-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.js migrate:rollback",
    "seed": "knex --knexfile knexfile.js seed:run",
    "seed:uat": "knex --knexfile knexfile.js seed:run --specific=002_uat_catalog.js",
    "seed:pc": "knex --knexfile knexfile.js seed:run --specific=003_pc_hardware_catalog.js",
    "db:role": "node src/db/create-app-role.js",
    "db:clean": "node src/db/clean.js",
    "db:reset": "node src/db/reset.js",
    "backup": "node scripts/backup-restore.js",
    "backup:schedule": "node scripts/backup-restore.js --schedule",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js && npm run seed:pc"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "jose": "^6.2.12",
    "knex": "^3.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
