# ==============================================================================
# MicroLedger Server Environment Configuration
# ==============================================================================

# Database connection used for running migrations, schema setup, and seeding
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/microledger

# Database connection used by the runtime application API (restricted app_user)
# In production/docker, app_user has REVOKE UPDATE, DELETE on ledger & audit tables
APP_DATABASE_URL=postgres://app_user:microledger_app_pass_123@localhost:5432/microledger

# Database pool and server port
DB_POOL_MAX=10
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Cryptographic secret for signing JWT access tokens (minimum 32 characters)
JWT_SECRET=development-secret-key-must-be-at-least-32-bytes-long

# Initial Administrator seed account (seeded on npm run seed)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=adminpassword123
INITIAL_ADMIN_FULL_NAME=System Admin

# Password for the restricted PostgreSQL app_user role (matches APP_DATABASE_URL)
APP_DB_ROLE_PASSWORD=microledger_app_pass_123

