# API Base URL for backend requests (when VITE_DEMO_MODE=false)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Standalone In-Browser Demo Mode (Zero Database / Zero Backend Setup)
# Set to 'true' to experience MicroLedger immediately in the browser with mock PC hardware catalog data
# Set to 'false' to connect to the live Node.js / PostgreSQL backend
VITE_DEMO_MODE=true

